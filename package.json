{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "/usr/lib/postgresql/16/bin/pg_ctl -D .postgres/data -l .postgres/postgres.log -o \"-p 55432 -k /tmp\" start",
    "db:stop": "/usr/lib/postgresql/16/bin/pg_ctl -D .postgres/data stop",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@paystack/inline-js": "^2.22.9",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "html-to-image": "^1.11.13",
    "next": "16.2.5",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.0",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
